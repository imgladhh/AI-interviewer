{
  "name": "ai-interviewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:e2e": "concurrently -k -s first -n web,worker \"next dev -H 127.0.0.1 -p 3100\" \"tsx src/workers/persona-worker.ts\"",
    "dev:smoke": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-vitest-safe.mjs run",
    "test:watch": "node scripts/run-vitest-safe.mjs watch",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/run-core-smoke.mjs",
    "check:repository": "npm run test && npx tsc --noEmit && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker:persona": "tsx src/workers/persona-worker.ts",
    "eval:policies": "tsx src/scripts/eval-policies.ts",
    "eval:system-design": "tsx src/scripts/eval-system-design.ts",
    "eval:system-design:real": "tsx src/scripts/eval-system-design-real-calibration.ts",
    "eval:system-design:weekly": "tsx src/scripts/eval-system-design-weekly.ts",
    "check:system-design-gates": "tsx src/scripts/check-system-design-gates.ts",
    "check:system-design-alerts": "tsx src/scripts/check-system-design-alerts.ts",
    "preflight:third-batch-sequences": "tsx src/scripts/preflight-third-batch-sequences.ts",
    "verify:third-batch-unique-constraints": "tsx src/scripts/verify-third-batch-unique-constraints.ts",
    "verify:third-batch-assessments": "tsx src/scripts/verify-third-batch-assessments.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.56.7",
    "ioredis": "^5.7.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.2.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
